<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ink & Dot: paper ground, ink text, the yellow dot as the signature colour. -->
    <style name="Theme.Publit" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/publit_ground</item>
        <item name="colorPrimary">@color/publit_ink</item>
        <item name="colorAccent">@color/publit_signature</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
